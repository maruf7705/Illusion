{
  "manifest_version": 3,
  "name": "Illusion Download Integration",
  "version": "1.2.3",
  "description": "High-performance IDM video/audio sniffer and multi-segment download acceleration for Arch Linux & Hyprland.",
  "browser_specific_settings": {
    "gecko": {
      "id": "illusion@archlinux.org",
      "strict_min_version": "109.0"
    }
  },
  "key": "",
  "permissions": [
    "scripting",
    "downloads",
    "nativeMessaging",
    "contextMenus",
    "storage",
    "cookies",
    "webRequest",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/mse_hook_main_world.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/video_detector.js"],
      "world": "ISOLATED",
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/floating_bar_ui.js"],
      "world": "ISOLATED",
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Illusion Downloader"
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
